# Copy this file to .env before running the client or Docker.
# The Google client ID must match the server's GOOGLE_CLIENT_ID exactly.
# Leave the actual secrets out of the repository; only keep the .env.example file.

VITE_API_URL=http://localhost:5000
VITE_GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
VITE_APP_NAME=Personal Expense Management
