# Copy this file to .env before running the server or Docker.
# Keep secrets out of source control and fill required values before startup.
# Optional tuning values below use safe defaults when omitted.

# Core server
PORT=5000
NODE_ENV=development
MONGO_URI=mongodb://127.0.0.1:27017/expense_manager
REDIS_URL=redis://127.0.0.1:6379
# replace_with_a_strong_random_secret
JWT_SECRET=7f4c9a2e8d1b6f3a0c5e7d9f2a4b6c8e1f3d5a7c9b2e4f6a8d0c3e5f7b9a1
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Worker / export runtime
WORKER_MODE=api
ENABLE_EXPORT_WORKER=false
EXPORT_DIR=exports
EXPORT_JOB_POLL_MS=1000
EXPORT_JOB_IDLE_POLL_MS=2000
EXPORT_JOB_MAX_RETRIES=3

# Export tuning
EXPORT_PDF_MAX_ROWS_PER_CHUNK=2500
EXPORT_XLSX_PROGRESS_CHECKPOINTS=10000,100000,200000,500000,1000000
PDFUNITE_BIN=pdfunite
PDF_FONT=

# Snapshot tuning
SNAPSHOT_DEFAULT_INTERVAL=20000
SNAPSHOT_STALE_JOB_MS=10000
SNAPSHOT_REQUEUE_INTERVAL_MS=30000
SNAPSHOT_CLAIM_POLL_MS=500
SNAPSHOT_FATAL_RETRY_MS=2000
SNAPSHOT_MAX_RETRIES=5
SNAPSHOT_RETRY_BASE_MS=1000

# Optional benchmark values
BENCHMARK_SAMPLE_SIZE=50
BENCHMARK_CONCURRENCY=4
