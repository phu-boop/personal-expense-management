# Copy this file to .env before running the server or Docker.
# Required values must be filled in before startup.
# If any value is left as a placeholder, the app will fail with a clear error message.

PORT=5000
MONGO_URI=mongodb://127.0.0.1:27017/expense_manager?replicaSet=rs0
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=replace_with_a_strong_random_secret
GOOGLE_CLIENT_ID=your-google-client-id-here.apps.googleusercontent.com
CORS_ORIGIN=${CORS_ORIGIN:-http://localhost:5173,http://127.0.0.1:5173}
